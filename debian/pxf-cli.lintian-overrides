# 3rd-party package installed outside vendor-managed directories.
dir-or-file-in-opt

# pxf-cli is a Go binary. Standard hardening flags (PIE/RELRO) are not
# applied by the current Go build. Not fixed here — deliberately out of scope.
hardening-no-pie opt/greengagedb/pxf/bin/pxf-cli
hardening-no-relro opt/greengagedb/pxf/bin/pxf-cli
